{
  "name": "@tvlm/ui",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Svelte 5 UI: the wizard (W1–W9) and the workspace, i18n strings, design tokens. One bundle for web, desktop and Android — the host app only provides an AdbDevice factory and the brand.",
  "type": "module",
  "svelte": "./src/index.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tvlm/adb": "workspace:*",
    "@tvlm/core": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
